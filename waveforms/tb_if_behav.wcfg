<?xml version="1.0" encoding="UTF-8"?>
<wave_config>
   <wave_state>
   </wave_state>
   <db_ref_list>
      <db_ref path="tb_if_behav.wdb" id="1">
         <top_modules>
            <top_module name="glbl" />
            <top_module name="tb_if" />
         </top_modules>
      </db_ref>
   </db_ref_list>
   <zoom_setting>
      <ZoomStartTime time="0.000 ns"></ZoomStartTime>
      <ZoomEndTime time="125.501 ns"></ZoomEndTime>
      <Cursor1Time time="0.000 ns"></Cursor1Time>
   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="170"></NameColumnWidth>
      <ValueColumnWidth column_width="124"></ValueColumnWidth>
   </column_width_setting>
   <WVObjectSize size="5" />
   <wvobject fp_name="/tb_if/clk" type="logic">
      <obj_property name="ElementShortName">clk</obj_property>
      <obj_property name="ObjectShortName">clk</obj_property>
   </wvobject>
   <wvobject fp_name="/tb_if/reset" type="logic">
      <obj_property name="ElementShortName">reset</obj_property>
      <obj_property name="ObjectShortName">reset</obj_property>
   </wvobject>
   <wvobject fp_name="/tb_if/pc_current" type="array">
      <obj_property name="ElementShortName">pc_current[31:0]</obj_property>
      <obj_property name="ObjectShortName">pc_current[31:0]</obj_property>
   </wvobject>
   <wvobject fp_name="/tb_if/pc_future" type="array">
      <obj_property name="ElementShortName">pc_future[31:0]</obj_property>
      <obj_property name="ObjectShortName">pc_future[31:0]</obj_property>
   </wvobject>
   <wvobject fp_name="/tb_if/instruction" type="array">
      <obj_property name="ElementShortName">instruction[31:0]</obj_property>
      <obj_property name="ObjectShortName">instruction[31:0]</obj_property>
   </wvobject>
</wave_config>
